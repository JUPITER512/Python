   "source": [
    "str2='Hello World'\n",
    "wordList=str2.split()\n",
    "newStr=''\n",
    "\n",
    "\n",
    "\n",
    "for word in wordList:\n",
    "    reversedword=''.join(reversed(word))\n",
    "    swapped_case=reversedword.swapcase()\n",
    "    newStr+=swapped_case+' '\n",
    "\n",
    "print(newStr)\n"
   ]
